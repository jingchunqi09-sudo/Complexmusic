//=============================================================================
// latency_profile.vh —— R61「延迟优先」档：三通道感知延迟的唯一真源
//
// 本文件只定义**编译期常量**，不含任何逻辑。所有延迟参数都在这里改，
// 不要在模块里散着改 —— 否则下一次想调延迟又得满工程 grep。
//
// 适用范围（三条独立通道，互不共享状态）：
//   ① 左手：ADC128S102 扫描 + 分弦按品判定（left_hand_*）
//   ② 右手弓：PAW3395 光流 + bow_motion_tracker（鼠标模块）
//   ③ 右手拨：AD7091R-4 压电 + piezo_string_det
//
//-----------------------------------------------------------------------------
// 一、算法层：三条通道各自的延迟是怎么构成的
//-----------------------------------------------------------------------------
// 延迟 = 采样周期 × 统计窗口数 + 判决拍数。R61 的动作是**同时压这两项**：
//
//   ① 左手（时分轮询，4 弦串行，物理上无法并行 —— 只有一组激励驱动、
//      一组 ADC 通道，同时激励会串扰，见 left_hand_sensor_adapter.v 头注释）
//        延迟 = 等槽(0..4×SLOT) + 槽内 settle + 证据分组 + 判决拍
//        R60: 4×1.25 ms = 5.00 ms 一轮，平均 2.57 ms
//        R61: 4×0.32 ms = 1.28 ms 一轮，平均 0.67 ms        → 3.8x
//      释放：HOLD_SLOTS=3 → 连续 4 轮零命中回空弦（20 ms → 5.1 ms）
//
//   ② 右手弓（PAW3395 每轮读 Motion+4×Delta+SQUAL，SPI 单字传输）
//        延迟 = 轮询周期 × 窗口样本数 + 起音确认样本数
//        R60: 1120 us/轮（833 Hz），9 样本窗 = 10.1 ms，起音 3 样本 = 3.4 ms
//        R61:  201 us/轮（4975 Hz），9 样本窗 =  1.81 ms，起音 2 样本 = 0.4 ms
//      注意：窗口**样本数不变**（WIN=9），只是采样变快，所以 speed8 的
//      量纲、OPEN_TH / CLOSE_TH / BOW_SUPPRESS_SPEED 全部不用重标。
//      这是本档最干净的一处改动 —— 只改时基，不改判据。
//
//   ③ 右手拨（AD7091R-4 四通道轮流转换 + 带通 + 双包络 + 窗内峰值判决）
//        FS_HZ 是**单通道**采样率（sample_valid 每读一个通道来一次），
//        判决窗按"四通道帧"计数：WIN_FR = WIN/4。
//        R60: 40 us/通道（24.9 kSPS），WIN=199 样本 → WIN_FR=50 帧 = 8.0 ms
//        R61: 20 us/通道（50.0 kSPS），WIN=200 样本 → WIN_FR=50 帧 = 4.0 ms
//      注意 FS_HZ 本身没写错（R17 注释里的 24.9 kSPS 是单通道口径），
//      错的只是"标称 _MS × 实际 fs"这层换算 —— R61 顺便把它对齐。
//
//      为什么采样率只提到 2 倍而不是更高：LAG（增长比回看窗）是**每通道
//      一条 16 位延迟线**，成本随时基线性增长。R60 是 148×4×16 = 9472 FF；
//      若提到 80 kSPS 并保持 6 ms 回看，要 30976 FF（CLS 已 84%，不可行）。
//      R61 的处理是把回看窗从 6 ms 收到 3 ms（与慢包络 τ 的比值不变，
//      判据语义等价），于是 150×4×16 = 9600 FF，与 R60 基本持平。
//
//-----------------------------------------------------------------------------
// 二、声音层：R61 主动放弃了什么（用户已知情并接受）
//-----------------------------------------------------------------------------
//   ① 左手：每槽扫描数 24 → 12，证据分组 4 → 2。单格按压/释放的统计样本
//      减半，press 71% / release 22% 两个门限在弱按（<400 码）时更容易抖。
//      表现：极轻按品偶尔需要两次才认；按住时品位跳变概率略升。
//      不影响：音高映射、共模判定、单弦故障隔离（这三条逻辑一行未动）。
//
//   ② 右手弓：起音确认 3 → 2 样本。放弓、磕碰这类**单样本**尖峰仍被
//      2 样本否决，但连续两个尖峰（≈0.4 ms）就能开弓。
//      表现：极端情况下（桌面敲击两下）可能误开弓一次并留下一个短音。
//      不影响：换弓 2 mm 迟滞、跳弓判据、位置积分、关弓释放（全是样本数量纲，
//      时基变快后自动等比缩短，不需要改）。
//
//   ③ 右手拨：逐通道死区 60 ms → 16 ms、全局硬消抖 24 ms → 8 ms、
//      软消抖 60 ms → 16 ms。这是本档牺牲最大的一项 —— 快速重复拨同一根弦时，
//      上一拨的尾音可能被当成新拨（力度偏低），密集轮指时出现概率变高。
//      表现：极快的连续拨弦可能少一次或力度偏小。
//      不影响：选弦投票（piezo_string_vote 的 VOTE_WIN / START_VOTE 都是
//      样本数量纲，时基变快后时间同比缩短，判据等价）。
//
//-----------------------------------------------------------------------------
// 三、时序 / 资源层：为什么这些数字是安全的
//-----------------------------------------------------------------------------
//   · 左手槽内时序（left_hand_sensor_adapter.v 的 $fatal 会拦住违规）：
//       一次完整 burst = 305×DIV = 915 clk；重复扫描 = 816 clk
//       LAST_START_TICK = SLOT - 915 - 2 = 15083 > SETTLE(1000)      ✓
//       2 组 × 2 扫描 × 816 = 3264 clk = 65 us < 320 us 槽长        ✓
//   · PAW3395 SPI：SCLK = 50 MHz / (2×13) = 1.92 MHz，低于器件 2 MHz 上限。
//       单字 = LEAD 50 + 16×2×13 + TRAIL 250 = 716 clk = 14.3 us。
//   · AD7091R-4 SPI：SCLK = 50 MHz / (2×8) = 3.125 MHz，远低于 50 MHz 上限；
//       单帧 = 16×2×8 = 256 clk = 5.12 us，加转换 guard 2.5 us 仍有余量。
//   · 资源：LAG 148（6 ms @24.9 kHz）→ 150（3 ms @50 kHz），
//       每通道延迟线 16 位 × 150，四通道共 9600 FF（R60 是 9472 FF）
//       → **净增 128 FF**，可忽略。回看窗与慢包络 τ 的比值保持不变
//       （0.59τ → 0.59τ），所以"增长比"判据的语义没有变，只是时间轴对折。
//   · 其余全部是常量改动，不新增数据通路、不改变任何扇出，
//     对 hold 的影响只来自布局漂移（与 R44/R57 的"加负载"不同类）。
//
//-----------------------------------------------------------------------------
// 四、架构层：真源唯一，改延迟只改这一个文件
//-----------------------------------------------------------------------------
//   例外：左手时基（槽长/settle/分组）不在本文件 —— 它由
//   config/left_hand_detection.json 生成 src/left_hand_vote_config.vh，
//   因为那三个值要跟 PC 端标定工具共用同一份配置。改左手时基请改 JSON
//   并运行 scripts/generate_left_hand_config.py，不要在这里加第二个真源。
//=============================================================================
`ifndef LATENCY_PROFILE_VH
`define LATENCY_PROFILE_VH

//-----------------------------------------------------------------------------
// ② 右手弓：PAW3395（鼠标模块）
//-----------------------------------------------------------------------------
// 轮询节拍。稳态时每轮只读 Motion + 4 个 Delta 字节（5 字），
// Product_ID/Inverse_ID 自检与 SQUAL 读数按轮次分频，不再每轮都做。
// 原值 50000（1 ms）是纯粹的空等，删掉它不改变任何判据。
`define R61_PAW_SPI_CLK_DIV      13    // SCLK = 50MHz/(2*13) = 1.92 MHz（器件上限 2 MHz）
`define R61_PAW_POLL_GAP_CYCLES  6000  // 轮间空等 = 120 us
`define R61_PAW_AUDIT_DIV        16    // 每 16 轮做一次 ID 自检（原：每轮）
`define R61_PAW_QUAL_DIV         16    // 每 16 轮读一次 SQUAL 0x07（原：每轮）

//-----------------------------------------------------------------------------
// ③ 右手拨：AD7091R-4 压电
//-----------------------------------------------------------------------------
// FS_HZ 必须是**实测单通道采样率**：全链所有 _MS 参数都按它换算成样本数。
`define R61_PIEZO_SPI_HALF        8     // SCLK = 3.125 MHz（帧传输 5.12 us）
`define R61_PIEZO_SAMPLE_GAP      600   // 帧间空等 = 12 us；单通道周期 ≈ 20 us
`define R61_PIEZO_FS_HZ           50000 // 单通道采样率（四通道帧率 12.5 kHz）
`define R61_PIEZO_WIN_MS          4     // 判决窗：200 样本 = 50 帧 = 4.0 ms（原 8 ms）
`define R61_PIEZO_DEAD_MS         16    // 逐通道死区（原 60）
`define R61_PIEZO_REFR_H_MS       8     // 全局硬消抖（原 24）
`define R61_PIEZO_REFR_S_MS       16    // 全局软消抖（原 60）
`define R61_PIEZO_WARM_MS         120   // 上电消隐（原 250）
`define R61_PIEZO_LAG             150   // 增长比回看窗 3 ms @50 kHz（原 148 = 6 ms @24.9 kHz）
`define R61_PIEZO_EF_S            5     // 快包络 τ = 32 样本 = 0.64 ms（原 1.29 ms，靠时基自动减半）

//-----------------------------------------------------------------------------
// ② 右手弓：bow_motion_tracker 判决参数（只有一项需要改）
//-----------------------------------------------------------------------------
// 窗口样本数 WIN 保持 9：采样率提高后窗口时间自动从 10.1 ms 掉到 1.81 ms，
// 而 speed8 / OPEN_TH / CLOSE_TH 的量纲完全不变，门限一个都不用重标。
`define R61_BOW_ATTACK_N         2     // 起音确认样本（原 3）；单样本尖峰仍被否决

`endif
